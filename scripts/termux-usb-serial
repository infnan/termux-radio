#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' '缺少 Python：请先执行 pkg install python' >&2
    exit 1
fi
if [[ -f "$script_dir/termux_usb_serial.py" ]]; then
    exec python3 "$script_dir/termux_usb_serial.py" "$@"
fi
exec python3 "${PREFIX:-/data/data/com.termux/files/usr}/libexec/termux-radio/termux_usb_serial.py" "$@"
